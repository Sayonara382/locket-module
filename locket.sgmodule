#!name=Locket-Module

[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts$|subscribers\/[^/]+$), script-path=https://raw.githubusercontent.com/sayonara382/locket-module/refs/heads/main/purchase.js, requires-body=true, max-size=-1, timeout=60

deleteHeader = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/.+\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/sayonara382/locket-module/refs/heads/main/overwrite.js, timeout=60

[MITM]
hostname = %APPEND% api.revenuecat.com
