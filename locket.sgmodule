[Script]
revenuecat = type=http-response, pattern=^https:\/\/api\.revenuecat\.com\/v1\/subscribers\/[^/]+$, script-path=https://raw.githubusercontent.com/sayonara382/locket-module/refs/heads/main/purchase.js, requires-body=true, timeout=30, max-size=-1
remove_auth = type=http-request, pattern=^https:\/\/api\.revenuecat\.com\/v1\/(receipts|subscribers), script-path=https://raw.githubusercontent.com/sayonara382/locket-module/refs/heads/main/overwrite.js, timeout=30

[MITM]
hostname = %APPEND% api.revenuecat.com